# ========== Hy3 API 配置 ==========
# 在腾讯混元平台申请，填自己的 Key（不要提交到 git）
HY3_API_KEY=your_api_key_here
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1
HY3_MODEL=hy3
HY3_TIMEOUT=30

# ========== 数据库配置（本地 MySQL）==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hygraph

# ========== 应用配置 ==========
DEBUG=true
